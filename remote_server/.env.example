# ==================== 基礎配置 ====================

# Hugging Face Token（用於下載模型）
HUGGINGFACE_TOKEN=your_huggingface_token_here

# 管理員 Token（用於訪問管理 API）
# 建議使用強密碼生成器生成至少 32 位的隨機字符串
ADMIN_TOKEN=your_admin_token_here_min_32_chars

# ==================== SMTP 郵件服務配置 ====================

# SMTP 服務器地址
SMTP_SERVER=smtp.gmail.com

# SMTP 端口（587 for TLS, 465 for SSL）
SMTP_PORT=587

# SMTP 用戶名（通常是你的郵箱地址）
SMTP_USERNAME=your_email@gmail.com

# SMTP 密碼（Gmail 用戶請使用應用專用密碼）
SMTP_PASSWORD=your_app_password

# 發件人郵箱地址
FROM_EMAIL=your_email@gmail.com

# ==================== 安全配置（SSDLC 要求）====================

# 加密金鑰（用於敏感數據加密）
# 請運行一次程序，它會自動生成並顯示，然後將其填入此處
ENCRYPTION_KEY=

# 郵箱哈希鹽值（用於郵箱地址哈希）
# 建議使用強密碼生成器生成
EMAIL_HASH_SALT=change_this_to_random_string_min_32_chars

# 允許的前端源（CORS 白名單，用逗號分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 信任的主機（防止 Host Header 攻擊，用逗號分隔）
TRUSTED_HOSTS=localhost,127.0.0.1

# 網域名稱（用於郵件連結）
DOMAIN_NAME=https://localhost:8100

# 是否啟用 API 文檔（生產環境建議設為 false）
ENABLE_DOCS=false

# ==================== 應用配置 ====================

# API 服務器端口
API_PORT=8100

# API 服務器主機
API_HOST=0.0.0.0

# 日誌級別（debug, info, warning, error, critical）
LOG_LEVEL=info

# ==================== 安全建議 ====================
# 1. 絕對不要將 .env 文件提交到版本控制系統
# 2. ADMIN_TOKEN 至少 32 位隨機字符串
# 3. EMAIL_HASH_SALT 至少 32 位隨機字符串
# 4. ENCRYPTION_KEY 由程序自動生成，請妥善保管
# 5. 生產環境請設置 ENABLE_DOCS=false
# 6. ALLOWED_ORIGINS 只包含實際使用的前端域名
# 7. 定期更換 ADMIN_TOKEN 和其他敏感憑證
