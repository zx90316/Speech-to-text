# ==================== 基礎配置 ====================

# Hugging Face Token（用於下載模型）
HUGGINGFACE_TOKEN=

# 管理員 Token（用於訪問管理 API）
# 建議使用強密碼生成器生成至少 32 位的隨機字符串
ADMIN_TOKEN=

EMAIL_WHITELIST=
# ==================== SMTP 郵件服務配置 ====================

# SMTP 服務器地址
SMTP_SERVER=smtp.gmail.com

# SMTP 端口（587 for TLS, 465 for SSL）
SMTP_PORT=587

# SMTP 用戶名（通常是你的郵箱地址）
SMTP_USERNAME=

# SMTP 密碼（Gmail 用戶請使用應用專用密碼）
SMTP_PASSWORD=

# 發件人郵箱地址
FROM_EMAIL=

# ==================== 安全配置（SSDLC 要求）====================

# 加密金鑰（用於敏感數據加密）
# 請運行一次程序，它會自動生成並顯示，然後將其填入此處
ENCRYPTION_KEY=

# 郵箱哈希鹽值（用於郵箱地址哈希）
# 建議使用強密碼生成器生成
EMAIL_HASH_SALT=

# 允許的前端源（CORS 白名單，用逗號分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 信任的主機（防止 Host Header 攻擊，用逗號分隔）
TRUSTED_HOSTS=localhost,127.0.0.1

# 是否啟用 API 文檔（生產環境建議設為 false）
ENABLE_DOCS=true

# ==================== 應用配置 ====================

# Uvicorn Worker 數量（建議值：1，因為使用記憶體儲存）
# 多 worker 時記憶體儲存不共享，會導致資料不一致
UVICORN_WORKERS=1

# API 服務器端口
# 使用 443 需要 root/管理員權限
# 建議使用 8100 並透過防火牆轉發
API_PORT=8100

# API 服務器主機（0.0.0.0 = 所有介面，127.0.0.1 = 僅本機）
API_HOST=0.0.0.0

# 日誌級別（debug, info, warning, error, critical）
LOG_LEVEL=info

API_BASE_URL=https://localhost:8100

